# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in the Node process. The browser talks to our own /realtime
# socket, never to api.x.ai, so no credential of any kind reaches the page.
XAI_API_KEY=xai-...

# Which voice Rock opens on: rex, sal, atlas, zagan, orion, perseus, leo,
# helix, zenith, rigel, castor, ursa, naksh, kepler, or a custom voice id.
# That is the heavy end of xAI's 26 voices. The lighter ones (ara, eve,
# carina, luna, iris, celeste, lumen, lux, cosmo, sirius, altair, helios)
# are left out of the picker, but still work if you name one here.
# XAI_VOICE=rex

# grok-voice-latest tracks the newest release; pin a snapshot if you'd rather.
# XAI_MODEL=grok-voice-latest

# Point the proxy at a gateway or a stub instead of xAI.
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# Server-side tools. Both are executed by xAI, not by us — no keys needed.
# XAI_WEB_SEARCH=true
# XAI_X_SEARCH=true

# Memory: the remember/forget tools, and the memory block in the prompt. The
# list itself lives in the browser — set this to false to switch the whole
# feature off for everyone the server serves.
# MEMORY=true

# Connectors: the agents Rock may hand a task to. You do not have to set any of
# this — the connectors panel in the page is where an agent is switched on,
# pointed at a workspace and given a mode, and what it saves (connectors.json)
# wins over everything below. These are the defaults for a fresh machine.
#
# A connector runs a CLI that edits files here, so nothing is on until you say
# so. The CLI has to be installed and logged in already.
# CONNECTORS=openclaw

# Where they work, how long one gets, and how many may run at once.
# CONNECTOR_CWD=/path/to/the/repo         # default: where the server was started
# CONNECTOR_FILE=connectors.json          # where the panel saves
# CONNECTOR_TIMEOUT=900                   # seconds
# CONNECTOR_LIMIT=3
# CONNECTOR_ANNOUNCE=true                 # Rock says so when a task settles

# OpenClaw — run as `openclaw agent exec <task> --json --timeout 0 --cwd <workspace>`.
# The command is the one thing the panel cannot change: which binary this server
# executes is not a decision that belongs to a browser.
# OPENCLAW_COMMAND=openclaw               # a whole command line: `npx openclaw`, `docker exec ... openclaw`
# OPENCLAW_MODEL=                         # provider/model, e.g. openai/gpt-5.6-sol
# OPENCLAW_MODE=isolated                  # isolated: exec's own defaults, scoped to the workspace
#                                         # ambient:  this machine's OpenClaw config, whatever it says
# OPENCLAW_ARGS=--auth-env-only           # appended last, so a flag here beats the ones above
# OPENCLAW_CWD=                           # overrides CONNECTOR_CWD for this agent

# Remote MCP servers, as a JSON array. Anything with credentials belongs here
# rather than in the page — the proxy is the only thing that reads it.
# Alternatively drop the same array in ./mcp.json, which is gitignored.
# XAI_MCP_SERVERS=[{"server_label":"my-tools","server_url":"https://mcp.example.com/mcp","authorization":"Bearer ..."}]

# PORT=5173

# Which interface the server binds, under `npm run dev` and `npm start` both.
# This machine only unless you say otherwise — there are no accounts here, and a
# connector edits real files. `npm start` takes serving TLS as saying otherwise,
# since a phone on the wifi is the reason to have it.
# HOST=0.0.0.0
